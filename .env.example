# Secrets management — any secret env var supports a _FILE suffix to load from a file:
#   GEMINI_API_KEY_FILE=/run/secrets/gemini_key
# This works with Docker secrets, systemd credentials, or any file-based secret store.
# Supported: GEMINI_API_KEY, ADMIN_API_KEY, WHATSAPP_APP_SECRET, TOKEN_ENCRYPTION_KEY,
#            GOOGLE_CLIENT_SECRET, TELEGRAM_BOT_TOKEN, FACEBOOK_APP_SECRET,
#            SYSTEM_USER_ACCESS_TOKEN, SENTRY_DSN

# Server
PORT=3000

# Admin API key (requests must send Authorization: Bearer <key>)
# Leave empty to disable auth (dev only)
ADMIN_API_KEY=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model for new businesses
DEFAULT_GEMINI_MODEL=gemini-3-flash-preview

# Max conversation history per customer
MAX_CONVERSATION_MESSAGES=20

# Scraper settings
SCRAPER_MAX_PAGES=10
SCRAPER_TIMEOUT_MS=10000
SCRAPER_CONTEXT_MAX_CHARS=30000
SCRAPER_PAGE_MAX_CHARS=8000
SCRAPER_USER_AGENT=ReplAI-Bot/1.0 (website-scraper)

# Message buffering — wait this many ms for additional messages before replying
MESSAGE_BUFFER_MS=5000
# Max wait time before replying even if messages keep arriving
MESSAGE_BUFFER_MAX_MS=15000

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=your_random_verify_token
WHATSAPP_APP_SECRET=              # Required in production: for webhook signature verification
WHATSAPP_API_VERSION=v21.0

# Telegram Bot — used for boss notifications (escalations, bookings, reminders)
# Create a bot via @BotFather on Telegram to get the token
TELEGRAM_BOT_TOKEN=

# Token encryption — encrypts WhatsApp tokens at rest in SQLite
# Required in production. Use a 64-char hex string (32 bytes) or a passphrase.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Escalation — auto-expire stale escalations after this many hours
ESCALATION_TIMEOUT_HOURS=24
# Escalation — hours before sending boss a stale-escalation reminder
ESCALATION_REMINDER_HOURS=4
# Boss message buffer — debounce delay for batching customer→boss forwarding (ms)
BOSS_BUFFER_MS=3000
# Boss message buffer — max wait time before forwarding (ms)
BOSS_BUFFER_MAX_MS=10000

# Scheduling — max re-generation loops per message turn
SCHEDULING_MAX_ITERATIONS=8
# How long to cache scheduling services per business before re-fetching (ms, default 24h)
SERVICES_CACHE_TTL_MS=86400000

# Gemini API resilience
GEMINI_TIMEOUT_MS=30000           # Timeout per Gemini API call (ms)
GEMINI_RETRIES=2                  # Retries on 429/503/network errors (exponential backoff)

# Gemini context caching — caches static system prompt per business (10% input cost)
GEMINI_CACHE_ENABLED=true         # Set to 'false' to disable context caching
GEMINI_CACHE_TTL_SECONDS=86400    # Cache TTL on Gemini API side (default 24h)

# Gemini thinking level for main chat (minimal, low, medium, high)
# Utility calls (fact extraction, summarization) always use 'minimal'
GEMINI_THINKING_LEVEL=low

# Conversation history summarization — compresses old messages into a summary
CONVERSATION_SUMMARY_THRESHOLD=20 # Min messages before summarization kicks in
CONVERSATION_RECENT_MESSAGES=10   # Number of recent messages to keep raw (rest gets summarized)

# Conversation cleanup — delete conversations older than this many days (hourly sweep)
CONVERSATION_TTL_DAYS=90

# Per-business Gemini rate limit (calls per hour per business)
GEMINI_RATE_LIMIT_PER_BUSINESS=60

# Logging level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Sentry error tracking (optional — get a free DSN at sentry.io)
SENTRY_DSN=

# Public base URL — used for .ics calendar links in boss booking notifications
# Example: https://yourdomain.com (no trailing slash)
BASE_URL=

# Google OAuth — enables "Sign in with Google" on the admin dashboard
# Both GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET must be set to enable Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of allowed Google emails (required — only these can log in)
GOOGLE_ALLOWED_EMAILS=admin@example.com,dev@example.com

# WhatsApp Embedded Signup — enables self-service WhatsApp connection for businesses
# Create a Meta app and configure "Facebook Login for Business" in the developer portal
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Login configuration ID from Meta Developer Portal > Facebook Login for Business
FACEBOOK_LOGIN_CONFIG_ID=
# System User Access Token from your Business Manager (non-expiring, one-time setup)
SYSTEM_USER_ACCESS_TOKEN=
